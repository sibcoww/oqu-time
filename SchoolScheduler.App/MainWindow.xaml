<Window x:Class="SchoolScheduler.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SchoolScheduler.App.ViewModels"
        xmlns:views="clr-namespace:SchoolScheduler.App.Views"
        mc:Ignorable="d"
        Title="School Scheduler" Height="600" Width="1000" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <!-- Placeholders for other ViewModels will just show their name via fallback TextBlock in production, 
             for now we can let WPF use ToString() fallback for empty DataTemplates, or define them later -->
        <DataTemplate DataType="{x:Type viewmodels:SchoolViewModel}">
            <TextBlock Text="Настройки школы" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ClassesViewModel}">
            <views:ClassesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:GroupsViewModel}">
            <views:GroupsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TeachersViewModel}">
            <views:TeachersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SubjectsViewModel}">
            <views:SubjectsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:RoomsViewModel}">
            <views:RoomsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TeachingLoadViewModel}">
            <views:TeachingLoadView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ConstraintsViewModel}">
            <views:ConstraintsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ScheduleViewModel}">
            <views:ScheduleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ExportViewModel}">
            <TextBlock Text="Экспорт" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <TextBlock Text="Настройки" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding NavigationItems}" Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" 
                                Command="{Binding Command}"
                                Background="Transparent" 
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="15,10" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Main Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="10" />
    </Grid>
</Window>
