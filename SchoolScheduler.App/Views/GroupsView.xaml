<UserControl x:Class="SchoolScheduler.App.Views.GroupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Класс" Binding="{Binding Class.Name}" Width="80"/><DataGridTextColumn Header="Группа" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Предмет / назначение" Binding="{Binding Subject.Name}" Width="*"/><DataGridCheckBoxColumn Header="Активна" Binding="{Binding IsActive}" Width="70"/></DataGrid.Columns></DataGrid>
   <Button Grid.Row="1" Content="Добавить группу" Command="{Binding AddCommand}" Margin="0,8,0,0" Padding="8"/>
  </Grid>
  <StackPanel Grid.Column="1"><TextBlock Text="Родительский класс"/><ComboBox ItemsSource="{Binding Classes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedGroup.ClassId}" Margin="0,4,0,8"/><TextBlock Text="Название группы"/><TextBox Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/><TextBlock Text="Предмет или назначение (необязательно)"/><ComboBox ItemsSource="{Binding Subjects}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedGroup.SubjectId}" Margin="0,4,0,8"/><CheckBox Content="Активна" IsChecked="{Binding SelectedGroup.IsActive}" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="В архив" Command="{Binding ArchiveCommand}" Padding="12,6" Margin="0,0,8,0"/><Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="12,6"/></StackPanel></StackPanel>
 </Grid>
</UserControl>
