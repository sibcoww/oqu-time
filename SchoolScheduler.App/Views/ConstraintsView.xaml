<UserControl x:Class="SchoolScheduler.App.Views.ConstraintsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Button Content="Проверить исходные данные" Command="{Binding ValidateCommand}" Padding="12,6"/><TextBlock Text="Критических ошибок:" Margin="20,0,5,0" VerticalAlignment="Center"/><TextBlock Text="{Binding CriticalCount}" FontWeight="Bold" Foreground="DarkRed" VerticalAlignment="Center"/><TextBlock Text="Предупреждений:" Margin="20,0,5,0" VerticalAlignment="Center"/><TextBlock Text="{Binding WarningCount}" FontWeight="Bold" Foreground="DarkOrange" VerticalAlignment="Center"/></StackPanel>
  <TextBlock Grid.Row="1" Margin="0,10" Text="Генерация доступна только при отсутствии критических ошибок." Foreground="Gray"/>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Issues}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Уровень" Binding="{Binding Severity}" Width="100"/><DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="180"/><DataGridTextColumn Header="Описание" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid>
  <DockPanel Grid.Row="3" Margin="0,10,0,6"><Button DockPanel.Dock="Left" Content="Проверить по нормам РК" Command="{Binding ValidateNormsCommand}" Padding="12,6" Margin="0,0,12,0"/><TextBlock Text="{Binding NormativeStatus}" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
  <DataGrid Grid.Row="4" ItemsSource="{Binding NormativeViolations}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Уровень" Binding="{Binding Severity}" Width="120"/><DataGridTextColumn Header="Правило" Binding="{Binding RuleCode}" Width="160"/><DataGridTextColumn Header="Нарушение нормы РК" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="260"/></DataGrid.Columns></DataGrid>
 </Grid>
</UserControl>
