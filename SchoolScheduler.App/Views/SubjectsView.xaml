<UserControl x:Class="SchoolScheduler.App.Views.SubjectsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DataGrid ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
    <DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Короткое" Binding="{Binding ShortName}" Width="120"/><DataGridTextColumn Header="Сложность" Binding="{Binding Difficulty}" Width="80"/></DataGrid.Columns>
   </DataGrid><Button Grid.Row="1" Content="Добавить предмет" Command="{Binding AddCommand}" Margin="0,8,0,0" Padding="8"/>
  </Grid>
  <StackPanel Grid.Column="1"><TextBlock Text="Название"/><TextBox Text="{Binding SelectedSubject.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
   <TextBlock Text="Короткое название"/><TextBox Text="{Binding SelectedSubject.ShortName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
   <TextBlock Text="Сложность (1–10)"/><TextBox Text="{Binding SelectedSubject.Difficulty, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
   <TextBlock Text="Тип"/><ComboBox ItemsSource="{Binding SubjectTypes}" SelectedItem="{Binding SelectedSubject.Type}" Margin="0,4,0,8"/>
   <CheckBox Content="Разрешить сдвоенные занятия" IsChecked="{Binding SelectedSubject.AllowDoubleLessons}" Margin="0,4,0,12"/>
   <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="10,6" HorizontalAlignment="Right"/>
  </StackPanel>
 </Grid>
</UserControl>
