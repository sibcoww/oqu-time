<Window x:Class="SchoolScheduler.App.Views.BulkCreateClassesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Массовое создание классов" Height="380" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Быстрое создание" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="С параллели:" />
            <TextBox Text="{Binding StartParallel}" Margin="0,5,0,10" />

            <TextBlock Text="По параллель:" />
            <TextBox Text="{Binding EndParallel}" Margin="0,5,0,10" />

            <TextBlock Text="Литеры (через запятую):" />
            <TextBox Text="{Binding Letters}" Margin="0,5,0,10" />
            <TextBlock Text="Пример: А, Б, В" FontSize="10" Foreground="Gray" Margin="0,-5,0,10" />

            <TextBlock Text="Макс. уроков в день (по умолчанию):" />
            <TextBox Text="{Binding MaxLessonsPerDay}" Margin="0,5,0,10" />

            <TextBlock Text="Смена (для всех):" />
            <ComboBox ItemsSource="{Binding Shifts}" 
                      DisplayMemberPath="Name" 
                      SelectedItem="{Binding SelectedShift}" Margin="0,5,0,10" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" Width="80" Margin="0,0,10,0"/>
            <Button Content="Создать" Command="{Binding GenerateCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="100"/>
        </StackPanel>
    </Grid>
</Window>