<UserControl x:Class="SchoolScheduler.App.Views.ScheduleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Left" Content="Составить расписание" Command="{Binding GenerateCommand}" Padding="14,7" Margin="0,0,12,0"/><TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Вид:" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding ViewOptions}" SelectedItem="{Binding SelectedViewOption}" DisplayMemberPath="Name" Width="150" Margin="6,0,16,0"/><TextBlock Text="Ресурс:" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" DisplayMemberPath="Name" Width="220" Margin="6,0,0,0"/></StackPanel>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="All" RowHeight="58">
   <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4"/></Style></DataGrid.Resources>
   <DataGrid.Columns><DataGridTextColumn Header="Урок" Binding="{Binding LessonNumber}" Width="55"/><DataGridTextColumn Header="Пн" Binding="{Binding Monday}" Width="*"/><DataGridTextColumn Header="Вт" Binding="{Binding Tuesday}" Width="*"/><DataGridTextColumn Header="Ср" Binding="{Binding Wednesday}" Width="*"/><DataGridTextColumn Header="Чт" Binding="{Binding Thursday}" Width="*"/><DataGridTextColumn Header="Пт" Binding="{Binding Friday}" Width="*"/><DataGridTextColumn Header="Сб" Binding="{Binding Saturday}" Width="*"/></DataGrid.Columns>
  </DataGrid>
  <Expander Grid.Row="3" Header="Оценка и штрафы" Margin="0,8,0,0"><StackPanel><TextBlock Text="{Binding Quality, StringFormat=Качество: {0}/100}" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Penalties}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Name}"/><Run Text=": "/><Run Text="{Binding Value}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
 </Grid>
</UserControl>
