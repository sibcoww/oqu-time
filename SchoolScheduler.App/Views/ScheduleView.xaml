<UserControl x:Class="SchoolScheduler.App.Views.ScheduleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  <DataTemplate x:Key="LessonTemplate">
   <Border Background="#EEF5FF" BorderBrush="#9DBBE5" BorderThickness="1" CornerRadius="3" Margin="2" Padding="4" MouseMove="Lesson_MouseMove" Tag="{Binding}">
    <DockPanel><TextBlock DockPanel.Dock="Right" Text="📌" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" Margin="4,0,0,0"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" ToolTip="Перетащите для переноса или обмена. Правый клик — закрепить."/></DockPanel>
    <Border.ContextMenu><ContextMenu><MenuItem Header="Закрепить / снять закрепление" Click="TogglePin_Click"/></ContextMenu></Border.ContextMenu>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="MondayTemplate"><ItemsControl Tag="{Binding Monday}" ItemsSource="{Binding Monday.Lessons}" ItemTemplate="{StaticResource LessonTemplate}" MinHeight="54" AllowDrop="True" Drop="Cell_Drop" DragOver="Cell_DragOver"/></DataTemplate>
  <DataTemplate x:Key="TuesdayTemplate"><ItemsControl Tag="{Binding Tuesday}" ItemsSource="{Binding Tuesday.Lessons}" ItemTemplate="{StaticResource LessonTemplate}" MinHeight="54" AllowDrop="True" Drop="Cell_Drop" DragOver="Cell_DragOver"/></DataTemplate>
  <DataTemplate x:Key="WednesdayTemplate"><ItemsControl Tag="{Binding Wednesday}" ItemsSource="{Binding Wednesday.Lessons}" ItemTemplate="{StaticResource LessonTemplate}" MinHeight="54" AllowDrop="True" Drop="Cell_Drop" DragOver="Cell_DragOver"/></DataTemplate>
  <DataTemplate x:Key="ThursdayTemplate"><ItemsControl Tag="{Binding Thursday}" ItemsSource="{Binding Thursday.Lessons}" ItemTemplate="{StaticResource LessonTemplate}" MinHeight="54" AllowDrop="True" Drop="Cell_Drop" DragOver="Cell_DragOver"/></DataTemplate>
  <DataTemplate x:Key="FridayTemplate"><ItemsControl Tag="{Binding Friday}" ItemsSource="{Binding Friday.Lessons}" ItemTemplate="{StaticResource LessonTemplate}" MinHeight="54" AllowDrop="True" Drop="Cell_Drop" DragOver="Cell_DragOver"/></DataTemplate>
  <DataTemplate x:Key="SaturdayTemplate"><ItemsControl Tag="{Binding Saturday}" ItemsSource="{Binding Saturday.Lessons}" ItemTemplate="{StaticResource LessonTemplate}" MinHeight="54" AllowDrop="True" Drop="Cell_Drop" DragOver="Cell_DragOver"/></DataTemplate>
 </UserControl.Resources>
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Left" Content="Составить расписание" Command="{Binding GenerateCommand}" Padding="14,7" Margin="0,0,8,0"/><Button DockPanel.Dock="Left" Content="Отменить" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Padding="14,7" Margin="0,0,12,0"/><TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Вид:" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding ViewOptions}" SelectedItem="{Binding SelectedViewOption}" DisplayMemberPath="Name" Width="150" Margin="6,0,16,0"/><TextBlock Text="Ресурс:" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" DisplayMemberPath="Name" Width="220" Margin="6,0,0,0"/><TextBlock Text="Перетащите занятие для переноса или обмена" Foreground="#666" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="All" RowHeight="Auto">
   <DataGrid.Columns><DataGridTextColumn Header="Урок" Binding="{Binding LessonNumber}" Width="55"/><DataGridTemplateColumn Header="Пн" CellTemplate="{StaticResource MondayTemplate}" Width="*"/><DataGridTemplateColumn Header="Вт" CellTemplate="{StaticResource TuesdayTemplate}" Width="*"/><DataGridTemplateColumn Header="Ср" CellTemplate="{StaticResource WednesdayTemplate}" Width="*"/><DataGridTemplateColumn Header="Чт" CellTemplate="{StaticResource ThursdayTemplate}" Width="*"/><DataGridTemplateColumn Header="Пт" CellTemplate="{StaticResource FridayTemplate}" Width="*"/><DataGridTemplateColumn Header="Сб" CellTemplate="{StaticResource SaturdayTemplate}" Width="*"/></DataGrid.Columns>
  </DataGrid>
  <Expander Grid.Row="3" Header="Оценка и штрафы" Margin="0,8,0,0"><StackPanel><TextBlock Text="{Binding Quality, StringFormat=Качество: {0}/100}" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Penalties}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Name}"/><Run Text=": "/><Run Text="{Binding Value}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
 </Grid>
</UserControl>
